# Copy to .env and fill in real values. Never commit the real .env file.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/order_tracking?schema=public"
# Used by `prisma migrate dev` for drift detection. Local dev only — never needed in production.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/order_tracking_shadow?schema=public"

JWT_SECRET="replace-with-a-long-random-string"

PORT=3000
NODE_ENV=development

# The public-facing origin clients actually reach this API at — used to build absolute URLs
# for uploaded product images. Local dev matches PORT above; production must be set to the
# real public origin (e.g. http://51.79.159.222:8080), which differs from the internal PORT
# once you're behind Nginx.
PUBLIC_BASE_URL=http://localhost:3000
